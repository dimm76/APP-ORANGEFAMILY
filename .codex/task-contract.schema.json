{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["task_id", "objective", "base_ref", "allowed_paths", "acceptance_criteria", "out_of_scope", "required_checks", "hard_stop_conditions"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["AUTO_CONTINUE", "BLOCKED", "HARD_STOP", "COMPLETE"]},
    "blockers": {"type": "array", "items": {"type": "object", "required": ["category", "reason", "evidence", "resolved"], "properties": {"category": {"enum": ["human_decision", "missing_authorization", "destructive_risk", "security_risk", "external_interaction", "git_conflict", "technical_unavailable", "unexpected_state", "ci_deploy_failure"]}, "reason": {"type": "string"}, "evidence": {"type": "string", "minLength": 1}, "resolved": {"type": "boolean"}}, "additionalProperties": false}},
    "recovery_attempts": {"type": "array", "items": {"type": "object", "required": ["action", "result"], "properties": {"action": {"type": "string"}, "result": {"type": "string"}}, "additionalProperties": false}},
    "check_results": {"type": "array", "items": {"type": "object", "required": ["check", "status", "evidence"], "properties": {"check": {"type": "string"}, "status": {"enum": ["PASS", "PASS_WITH_BASELINE", "PASS_IMPROVED", "FAIL", "BLOCKED"]}, "evidence": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "documentation_impact": {"type": "object", "required": ["required", "areas", "canonical_docs", "reason"], "properties": {"required": {"type": "boolean"}, "areas": {"type": "array", "items": {"enum": ["api", "database", "security", "android", "ui", "operations", "workflow"]}}, "canonical_docs": {"type": "array", "items": {"type": "string"}}, "reason": {"type": "string", "minLength": 1}, "resolution": {"enum": ["UPDATED", "NO_CHANGE_REQUIRED"]}, "evidence": {"type": "string"}}, "additionalProperties": false},
    "objective": {"type": "string", "minLength": 1},
    "base_ref": {"type": "string"}, "base_sha": {"type": "string"}, "expected_head_sha": {"type": "string"}, "working_branch": {"type": "string"},
    "allowed_paths": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "acceptance_criteria": {"type": "array", "items": {"type": "object", "required": ["id", "description"], "properties": {"id": {"type": "string"}, "description": {"type": "string"}, "satisfied": {"type": "boolean"}, "evidence": {"type": "array", "items": {"type": "object"}}}, "additionalProperties": false}},
    "semantic_boundaries": {"type": "array", "items": {"type": "object", "required": ["boundary", "productive_entrypoint", "downstream", "evidence_required"], "properties": {"boundary": {"type": "string"}, "productive_entrypoint": {"type": "string"}, "downstream": {"type": "string"}, "evidence_required": {"type": "string"}, "required": {"type": "boolean"}, "satisfied": {"type": "boolean"}, "evidence": {"type": "array", "items": {"type": "object"}}}, "additionalProperties": false}},
    "out_of_scope": {"type": "array", "items": {"type": "string"}},
    "change_types": {"type": "array", "items": {"enum": ["frontend", "backend", "database", "android", "api-contract", "storage", "documentation", "security", "workflow"]}},
    "required_checks": {"type": "array", "items": {"enum": ["diff", "frontend", "ui", "backend", "database", "android", "documentation", "security"]}},
    "authorized_operations": {"type": "array", "items": {"enum": ["git.push_feature", "git.push_main", "database.migrate_local", "database.migrate_production", "vps.inspect_readonly", "vps.deploy_production", "vps.restart_backend", "android.test", "android.build_debug", "android.instrumented_test", "android.build_release", "android.install_adb", "android.publish_release", "android.prepare_release", "prepare_android_release", "build_android_release", "adb_install_release", "publish_android_release", "register_android_release"]}},
    "visual_validation": {"type": "object", "required": ["required"], "properties": {"required": {"type": "boolean"}, "performed": {"type": "boolean"}, "evidence": {"type": "string"}}, "additionalProperties": false}, "hard_stop_conditions": {"type": "array", "items": {"type": "string"}},
    "interactive_human_steps": {"type": "array", "items": {"type": "string"}}, "required_docs": {"type": "array", "items": {"type": "string"}}, "notes": {"type": "string"},
    "risk": {"enum": ["low", "medium", "high", "critical"]}, "requires_security_review": {"type": "boolean"}
  },
  "additionalProperties": false
}
